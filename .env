PORT=5000
# NODE_ENV=production <-- Dihapus: tidak valid di Vite, pakai default 'development'

# ── Frontend URL (untuk CORS backend) ────────────────────────────
# Saat development lokal: gunakan localhost
# Saat production: ganti ke URL domain (https://dashboard-testing.ignivera.com)
CLIENT_URL=http://localhost:5173

# ── Backend URL (dibaca oleh Vite/frontend) ──────────────────────
VITE_BACKEND_URL=http://localhost:5000

# ── MySQL Database (lokal) ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_fire_db

# API_SECRET_KEY=bebas_isi_kunci_rahasia_anda
